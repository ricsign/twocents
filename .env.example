# twocents.ai — every variable here is optional.
# Copy to .env.local and set what you need.

# ---------------------------------------------------------------------------
# The only one you are likely to set.
# ---------------------------------------------------------------------------

# Leaving this empty is a supported mode, not a broken one. With no key the app
# runs on a scripted provider: the briefing chat answers, the four agents
# negotiate, a plan comes out, the private reports get written, and no screen
# shows an error. Set it and the agents are live — they write their own lines
# and build their own offers.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Everything below has a working default. Set one only to change it.
# ---------------------------------------------------------------------------

# Set to 1 to use the scripted run even when a key is present. Useful for
# rehearsing the demo without spending tokens, or for a deterministic run.
# TWOCENTS_FORCE_OFFLINE=1

# The small model: briefing replies, voice previews, and every negotiation
# turn. This is where the call volume is, so it is where the cheap model goes.
# TWOCENTS_MODEL_FAST=claude-haiku-4-5

# The large model: the final plan and the four private reports, and nothing
# else. The two things a human reads word by word.
# TWOCENTS_MODEL_SMART=claude-sonnet-4-5

# Every offer an agent puts on the table is priced against the live web before
# the room argues with it, using Anthropic's server-side search — two searches
# per offer, so five to eight in a run. Set to 0 to rehearse without paying for
# them; offers then get the canned prices instead and nothing else changes.
# TWOCENTS_WEB_SEARCH=0

# Wall-clock ceiling on one model call, in milliseconds. A call that runs past
# it falls back to the scripted answer rather than stalling the room. Read at
# call time, so a change takes effect on the next call, not the next restart.
# TWOCENTS_LLM_TIMEOUT_MS=20000

# The Town screen's pace at 1x, in milliseconds per spoken line. Lower it for a
# faster room; the speed control divides into it. Five rounds at the default is
# a little over half a minute of screen time.
# TWOCENTS_BEAT_MS=1100

# The itinerary is the one call that searches the web eight times and then
# writes a whole document, so it gets its own, much longer ceiling. Under the
# shared one above it never finished, and every itinerary was quietly the
# canned one. In milliseconds; read at call time.
# TWOCENTS_ITINERARY_TIMEOUT_MS=120000

# Set to 1 to open the briefing screen mid-conversation, with Maya's number
# already given and her agent already sitting on it. Off by default: a person
# opening /brief gets an agent that asks them what they want, and the panel
# beside it fills in from what they answer. Takes effect on the next RESET.
# TWOCENTS_SEED_BRIEF_CHAT=1

# Where the session is mirrored to disk, so a brief, a personality and four
# approvals survive a restart. Defaults to .twocents/ beside package.json.
# TWOCENTS_STATE_DIR=.twocents
